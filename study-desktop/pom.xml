<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.xiaoyiyuan</groupId>
    <artifactId>study-assistant</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>study-desktop</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.xiaoyiyuan</groupId>
      <artifactId>study-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      javafx-controls 传递依赖 javafx-graphics / javafx-base，但 ui/theme 的签名里直接出现
      javafx.scene.Scene / Font / Text（ThemeManager、JavaFontResolver），所以这里**显式**声明
      javafx-graphics：编译期与测试期都靠它解析，不依赖传递依赖的偶然性。
      版本只有父 POM 的 ${javafx.version} 一个来源。
    -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.xiaoyiyuan.study.ui.Launcher</mainClass>
          <options>
            <option>--enable-native-access=javafx.graphics</option>
          </options>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            ui/theme 的字体测试要起 JavaFX 工具包（必须看真实行为，这是本任务的悬置项之一）。
            JavaFX 在 classpath 方式下会警告「Unsupported JavaFX configuration: classes were loaded
            from 'unnamed module'」，但功能正常——那条警告无法用参数消除（XML 注释里不能写两个连字符，
            下面用全角破折号代替参数名前的两个连字符）。
            原生访问警告用 ALL UNNAMED 那一档（**不是** javafx.graphics）：classpath 模式下 JavaFX
            处在 unnamed module，写 javafx.graphics 会让 JVM 打
            「Unknown module: javafx.graphics specified to enable native access」，
            然后照样打「Restricted methods will be blocked in a future release」，等于没消掉
            （2026-10-14 fix round 1 实测；jpackage 的 java options 用 javafx.graphics 是对的，
             因为打包产物走 module path，那是另一套配置）。
          -->
          <argLine>-Dfile.encoding=UTF-8 --enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
